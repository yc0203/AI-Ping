{
  "name": "ai-ping",
  "productName": "AI-Ping",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop ping markers with region capture, translation and configurable AI assistance",
  "author": "AI-Ping contributors; based on lolPing by Danrui Meng",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run build:helper && electron-vite build && electron-builder --mac --arm64 --publish never",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "media": "npm run build:site && electron tools/capture-media/capture.mjs",
    "package:local": "npm run build && node tools/package-ai.mjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@noble/secp256k1": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "com.aiping.desktop",
    "productName": "AI-Ping",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper.exe",
          "to": "hook-helper.exe"
        },
        {
          "from": "native/text-selection.ps1",
          "to": "text-selection.ps1"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AI-Ping-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper",
          "to": "hook-helper"
        },
        {
          "from": "build",
          "to": ".",
          "filter": [
            "tray*Template*.png"
          ]
        }
      ],
      "extendInfo": {
        "NSAccessibilityUsageDescription": "AI-Ping reads the mouse and keyboard to open the ping wheel or the emote wheel when you hold its key and drag.",
        "NSDownloadsFolderUsageDescription": "AI-Ping saves update downloads to your Downloads folder.",
        "NSLocalNetworkUsageDescription": "AI-Ping finds the other people in your room on the local network and sends them your pings."
      }
    },
    "dmg": {
      "artifactName": "AI-Ping-${version}-arm64.dmg"
    }
  },
  "homepage": "https://github.com/yc0203/AI-Ping#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yc0203/AI-Ping.git"
  },
  "bugs": "https://github.com/yc0203/AI-Ping/issues"
}
